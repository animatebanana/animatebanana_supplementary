<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 880" width="1024" height="880">
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#000000"/>
    </marker>
    <style>
      #node_input, #title_resnest, #label_input_dim,
      #block_cardinal_1, #label_cardinal_1, #edge_input_to_c1,
      #block_c1_split_1, #node_c1_s1_conv1, #node_c1_s1_conv2, #label_c1_split1, #edge_c1_s1,
      #block_c1_split_r, #node_c1_sr_conv1, #node_c1_sr_conv2, #dots_c1, #label_c1_splitr, #edge_c1_sr,
      #node_c1_split_attn, #label_dim_c1, #edge_c1_s1_to_attn, #edge_c1_sr_to_attn,
      #block_cardinal_k, #dots_cardinals, #label_cardinal_k, #edge_input_to_ck,
      #block_ck_split_1, #node_ck_s1_conv1, #node_ck_s1_conv2, #label_ck_split1, #edge_ck_s1,
      #block_ck_split_r, #node_ck_sr_conv1, #node_ck_sr_conv2, #dots_ck, #label_ck_splitr, #edge_ck_sr,
      #node_ck_split_attn, #edge_ck_s1_to_attn, #edge_ck_sr_to_attn,
      #node_concatenate, #label_dim_concat, #edge_c1_to_concat, #edge_ck_to_concat,
      #node_conv_1x1_c, #label_dim_conv_out, #edge_concat_to_conv,
      #node_add, #label_dim_final, #edge_conv_to_add, #edge_residual {
        opacity: 0;
        animation-name: fadeIn;
        animation-duration: 0.5s;
        animation-fill-mode: forwards;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      #node_input, #title_resnest, #label_input_dim { animation-delay: 0.0s; }
      #block_cardinal_1, #label_cardinal_1, #edge_input_to_c1 { animation-delay: 0.5s; }
      #block_c1_split_1, #node_c1_s1_conv1, #node_c1_s1_conv2, #label_c1_split1, #edge_c1_s1 { animation-delay: 1.0s; }
      #block_c1_split_r, #node_c1_sr_conv1, #node_c1_sr_conv2, #dots_c1, #label_c1_splitr, #edge_c1_sr { animation-delay: 1.5s; }
      #node_c1_split_attn, #label_dim_c1, #edge_c1_s1_to_attn, #edge_c1_sr_to_attn { animation-delay: 2.0s; }
      #block_cardinal_k, #dots_cardinals, #label_cardinal_k, #edge_input_to_ck { animation-delay: 2.5s; }
      #block_ck_split_1, #node_ck_s1_conv1, #node_ck_s1_conv2, #label_ck_split1, #edge_ck_s1 { animation-delay: 3.0s; }
      #block_ck_split_r, #node_ck_sr_conv1, #node_ck_sr_conv2, #dots_ck, #label_ck_splitr, #edge_ck_sr { animation-delay: 3.5s; }
      #node_ck_split_attn, #edge_ck_s1_to_attn, #edge_ck_sr_to_attn { animation-delay: 4.0s; }
      #node_concatenate, #label_dim_concat, #edge_c1_to_concat, #edge_ck_to_concat { animation-delay: 4.5s; }
      #node_conv_1x1_c, #label_dim_conv_out, #edge_concat_to_conv { animation-delay: 5.0s; }
      #node_add, #label_dim_final, #edge_conv_to_add, #edge_residual { animation-delay: 5.5s; }

      .narr-text {
        opacity: 0;
        font-family: sans-serif;
        font-size: 15px;
        fill: #111111;
        text-anchor: middle;
      }

      @keyframes bannerStep {
        0% { opacity: 0; }
        1% { opacity: 1; }
        90% { opacity: 1; }
        100% { opacity: 0; }
      }

      @keyframes bannerFinal {
        0% { opacity: 0; }
        1% { opacity: 1; }
        100% { opacity: 1; }
      }

      #narr_ts1 { animation: bannerStep 0.5s 0.0s forwards; }
      #narr_ts2 { animation: bannerStep 0.5s 0.5s forwards; }
      #narr_ts3 { animation: bannerStep 0.5s 1.0s forwards; }
      #narr_ts4 { animation: bannerStep 0.5s 1.5s forwards; }
      #narr_ts5 { animation: bannerStep 0.5s 2.0s forwards; }
      #narr_ts6 { animation: bannerStep 0.5s 2.5s forwards; }
      #narr_ts7 { animation: bannerStep 0.5s 3.0s forwards; }
      #narr_ts8 { animation: bannerStep 0.5s 3.5s forwards; }
      #narr_ts9 { animation: bannerStep 0.5s 4.0s forwards; }
      #narr_ts10 { animation: bannerStep 0.5s 4.5s forwards; }
      #narr_ts11 { animation: bannerStep 0.5s 5.0s forwards; }
      #narr_ts12 { animation: bannerFinal 0.5s 5.5s forwards; }
    </style>
  </defs>

  <!-- Title & Top Level Labels -->
  <text id="title_resnest" data-id="title_resnest" data-class="text_node" data-parent="root" x="500" y="52" text-anchor="middle" font-family="sans-serif" font-weight="bold" font-size="20" fill="#000000">ResNeSt Block</text>
  <text id="label_input_dim" data-id="label_input_dim" data-class="text_node" data-parent="root" x="500" y="89" text-anchor="middle" font-family="sans-serif" font-style="italic" font-weight="bold" font-size="17" fill="#000000">(h, w, c)</text>

  <!-- Top Input Block -->
  <g id="node_input" data-id="node_input" data-class="standalone_node" data-parent="root">
    <rect x="412" y="103" width="170" height="49" fill="#ffffff" stroke="#000000" stroke-width="2.2"/>
    <text x="497" y="135" text-anchor="middle" font-family="sans-serif" font-size="19" fill="#000000">Input</text>
  </g>

  <!-- ==================== CARDINAL 1 ==================== -->
  <text id="label_cardinal_1" data-id="label_cardinal_1" data-class="text_node" data-parent="root" x="230" y="181" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#000000">Cardinal <tspan font-style="italic">1</tspan></text>

  <g id="block_cardinal_1" data-id="block_cardinal_1" data-class="block" data-parent="root">
    <rect x="20" y="196" width="428" height="324" rx="14" fill="none" stroke="#000000" stroke-width="2.2" stroke-dasharray="8,6"/>

    <!-- Split 1 Sub-block -->
    <text id="label_c1_split1" data-id="label_c1_split1" data-class="text_node" data-parent="block_cardinal_1" x="120" y="222" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Split <tspan font-style="italic">1</tspan></text>
    <g id="block_c1_split_1" data-id="block_c1_split_1" data-class="block" data-parent="block_cardinal_1">
      <rect x="35" y="236" width="168" height="194" rx="12" fill="#dedede" stroke="#000000" stroke-width="2.2" stroke-dasharray="6,4"/>

      <!-- Conv 1x1 Node -->
      <g id="node_c1_s1_conv1" data-id="node_c1_s1_conv1" data-class="child_node" data-parent="block_c1_split_1">
        <rect x="48" y="251" width="142" height="66" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="119" y="277" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv, <tspan font-style="italic">1x1</tspan>,</text>
        <text x="119" y="303" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">c’/k/r</text>
      </g>

      <!-- Conv 3x3 Node -->
      <g id="node_c1_s1_conv2" data-id="node_c1_s1_conv2" data-class="child_node" data-parent="block_c1_split_1">
        <rect x="48" y="343" width="142" height="63" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="119" y="369" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv,</text>
        <text x="119" y="394" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">3x3, c’/k</text>
      </g>
    </g>

    <!-- Dots between Split 1 and Split r -->
    <text id="dots_c1" data-id="dots_c1" data-class="text_node" data-parent="block_cardinal_1" x="229" y="327" text-anchor="middle" font-family="sans-serif" font-weight="bold" font-size="20" fill="#000000">...</text>

    <!-- Split r Sub-block -->
    <text id="label_c1_splitr" data-id="label_c1_splitr" data-class="text_node" data-parent="block_cardinal_1" x="345" y="222" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Split <tspan font-style="italic">r</tspan></text>
    <g id="block_c1_split_r" data-id="block_c1_split_r" data-class="block" data-parent="block_cardinal_1">
      <rect x="256" y="236" width="168" height="194" rx="12" fill="#dedede" stroke="#000000" stroke-width="2.2" stroke-dasharray="6,4"/>

      <!-- Conv 1x1 Node -->
      <g id="node_c1_sr_conv1" data-id="node_c1_sr_conv1" data-class="child_node" data-parent="block_c1_split_r">
        <rect x="269" y="251" width="142" height="66" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="340" y="277" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv, <tspan font-style="italic">1x1</tspan>,</text>
        <text x="340" y="303" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">c’/k/r</text>
      </g>

      <!-- Conv 3x3 Node -->
      <g id="node_c1_sr_conv2" data-id="node_c1_sr_conv2" data-class="child_node" data-parent="block_c1_split_r">
        <rect x="269" y="343" width="142" height="63" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="340" y="369" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv,</text>
        <text x="340" y="394" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">3x3, c’/k</text>
      </g>
    </g>

    <!-- Split Attention Block -->
    <g id="node_c1_split_attn" data-id="node_c1_split_attn" data-class="child_node" data-parent="block_cardinal_1">
      <rect x="127" y="462" width="207" height="52" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
      <text x="230" y="495" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#000000">Split Attention</text>
    </g>
  </g>

  <!-- Dots between Cardinals -->
  <text id="dots_cardinals" data-id="dots_cardinals" data-class="text_node" data-parent="root" x="495" y="338" text-anchor="middle" font-family="sans-serif" font-weight="bold" font-size="22" fill="#000000">...</text>

  <!-- ==================== CARDINAL K ==================== -->
  <text id="label_cardinal_k" data-id="label_cardinal_k" data-class="text_node" data-parent="root" x="755" y="181" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#000000">Cardinal <tspan font-style="italic">k</tspan></text>

  <g id="block_cardinal_k" data-id="block_cardinal_k" data-class="block" data-parent="root">
    <rect x="541" y="196" width="428" height="324" rx="14" fill="none" stroke="#000000" stroke-width="2.2" stroke-dasharray="8,6"/>

    <!-- Split 1 Sub-block -->
    <text id="label_ck_split1" data-id="label_ck_split1" data-class="text_node" data-parent="block_cardinal_k" x="641" y="222" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Split <tspan font-style="italic">1</tspan></text>
    <g id="block_ck_split_1" data-id="block_ck_split_1" data-class="block" data-parent="block_cardinal_k">
      <rect x="556" y="236" width="168" height="194" rx="12" fill="#dedede" stroke="#000000" stroke-width="2.2" stroke-dasharray="6,4"/>

      <!-- Conv 1x1 Node -->
      <g id="node_ck_s1_conv1" data-id="node_ck_s1_conv1" data-class="child_node" data-parent="block_ck_split_1">
        <rect x="571" y="251" width="137" height="66" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="639" y="277" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv, <tspan font-style="italic">1x1</tspan>,</text>
        <text x="639" y="303" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">c’/k/r</text>
      </g>

      <!-- Conv 3x3 Node -->
      <g id="node_ck_s1_conv2" data-id="node_ck_s1_conv2" data-class="child_node" data-parent="block_ck_split_1">
        <rect x="571" y="343" width="137" height="63" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="639" y="369" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv,</text>
        <text x="639" y="394" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">3x3, c’/k</text>
      </g>
    </g>

    <!-- Dots between Split 1 and Split r -->
    <text id="dots_ck" data-id="dots_ck" data-class="text_node" data-parent="block_cardinal_k" x="753" y="327" text-anchor="middle" font-family="sans-serif" font-weight="bold" font-size="20" fill="#000000">...</text>

    <!-- Split r Sub-block -->
    <text id="label_ck_splitr" data-id="label_ck_splitr" data-class="text_node" data-parent="block_cardinal_k" x="866" y="222" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Split <tspan font-style="italic">r</tspan></text>
    <g id="block_ck_split_r" data-id="block_ck_split_r" data-class="block" data-parent="block_cardinal_k">
      <rect x="781" y="236" width="168" height="194" rx="12" fill="#dedede" stroke="#000000" stroke-width="2.2" stroke-dasharray="6,4"/>

      <!-- Conv 1x1 Node -->
      <g id="node_ck_sr_conv1" data-id="node_ck_sr_conv1" data-class="child_node" data-parent="block_ck_split_r">
        <rect x="796" y="251" width="137" height="66" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="864" y="277" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv, <tspan font-style="italic">1x1</tspan>,</text>
        <text x="864" y="303" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">c’/k/r</text>
      </g>

      <!-- Conv 3x3 Node -->
      <g id="node_ck_sr_conv2" data-id="node_ck_sr_conv2" data-class="child_node" data-parent="block_ck_split_r">
        <rect x="796" y="343" width="137" height="63" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
        <text x="864" y="369" text-anchor="middle" font-family="sans-serif" font-size="17" fill="#000000">Conv,</text>
        <text x="864" y="394" text-anchor="middle" font-family="sans-serif" font-style="italic" font-size="17" fill="#000000">3x3, c’/k</text>
      </g>
    </g>

    <!-- Split Attention Block -->
    <g id="node_ck_split_attn" data-id="node_ck_split_attn" data-class="child_node" data-parent="block_cardinal_k">
      <rect x="649" y="456" width="207" height="52" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
      <text x="752" y="489" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#000000">Split Attention</text>
    </g>
  </g>

  <!-- Side Dimension Text -->
  <text id="label_dim_c1" data-id="label_dim_c1" data-class="text_node" data-parent="root" x="72" y="465" text-anchor="middle" font-family="sans-serif" font-style="italic" font-weight="bold" font-size="16" fill="#000000">(h, w, c’/k)</text>
  <text id="label_dim_concat" data-id="label_dim_concat" data-class="text_node" data-parent="root" x="350" y="556" text-anchor="middle" font-family="sans-serif" font-style="italic" font-weight="bold" font-size="16" fill="#000000">(h, w, c’/k)</text>

  <!-- Bottom Blocks -->
  <!-- Concatenate Node -->
  <g id="node_concatenate" data-id="node_concatenate" data-class="standalone_node" data-parent="root">
    <rect x="412" y="554" width="170" height="49" fill="#ffffff" stroke="#000000" stroke-width="2.2"/>
    <text x="497" y="586" text-anchor="middle" font-family="sans-serif" font-size="19" fill="#000000">Concatenate</text>
  </g>

  <text id="label_dim_conv_out" data-id="label_dim_conv_out" data-class="text_node" data-parent="root" x="355" y="626" text-anchor="middle" font-family="sans-serif" font-style="italic" font-weight="bold" font-size="16" fill="#000000">(h, w, c’)</text>

  <!-- Conv 1x1, c Node -->
  <g id="node_conv_1x1_c" data-id="node_conv_1x1_c" data-class="standalone_node" data-parent="root">
    <rect x="412" y="630" width="170" height="49" fill="#b9d7fb" stroke="#000000" stroke-width="2.2"/>
    <text x="497" y="662" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#000000">Conv, <tspan font-style="italic">1x1, c</tspan></text>
  </g>

  <text id="label_dim_final" data-id="label_dim_final" data-class="text_node" data-parent="root" x="358" y="714" text-anchor="middle" font-family="sans-serif" font-style="italic" font-weight="bold" font-size="16" fill="#000000">(h, w, c)</text>

  <!-- Add Node (Circle with +) -->
  <g id="node_add" data-id="node_add" data-class="standalone_node" data-parent="root">
    <circle cx="497" cy="728" r="17" fill="#ffffff" stroke="#000000" stroke-width="2.2"/>
    <text x="497" y="734" text-anchor="middle" font-family="sans-serif" font-size="22" font-weight="bold" fill="#000000">+</text>
  </g>

  <!-- ==================== EDGES / ARROWS ==================== -->
  <g>
    <!-- From Input to Cardinal 1 -->
    <path id="edge_input_to_c1" data-id="edge_input_to_c1" data-class="edge" data-source="node_input" data-target="block_cardinal_1" d="M 468 152 L 426 193" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>
    
    <!-- From Input to Cardinal k -->
    <path id="edge_input_to_ck" data-id="edge_input_to_ck" data-class="edge" data-source="node_input" data-target="block_cardinal_k" d="M 526 152 L 568 193" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Inside Cardinal 1: Split 1 conv1 -> conv2 -->
    <line id="edge_c1_s1" data-id="edge_c1_s1" data-class="edge" data-source="node_c1_s1_conv1" data-target="node_c1_s1_conv2" x1="119" y1="317" x2="119" y2="341" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Inside Cardinal 1: Split r conv1 -> conv2 -->
    <line id="edge_c1_sr" data-id="edge_c1_sr" data-class="edge" data-source="node_c1_sr_conv1" data-target="node_c1_sr_conv2" x1="340" y1="317" x2="340" y2="341" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Cardinal 1: Split 1 conv2 -> Split Attention -->
    <path id="edge_c1_s1_to_attn" data-id="edge_c1_s1_to_attn" data-class="edge" data-source="node_c1_s1_conv2" data-target="node_c1_split_attn" d="M 115 430 L 175 460" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Cardinal 1: Split r conv2 -> Split Attention -->
    <path id="edge_c1_sr_to_attn" data-id="edge_c1_sr_to_attn" data-class="edge" data-source="node_c1_sr_conv2" data-target="node_c1_split_attn" d="M 345 430 L 285 460" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Inside Cardinal k: Split 1 conv1 -> conv2 -->
    <line id="edge_ck_s1" data-id="edge_ck_s1" data-class="edge" data-source="node_ck_s1_conv1" data-target="node_ck_s1_conv2" x1="639" y1="317" x2="639" y2="341" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Inside Cardinal k: Split r conv1 -> conv2 -->
    <line id="edge_ck_sr" data-id="edge_ck_sr" data-class="edge" data-source="node_ck_sr_conv1" data-target="node_ck_sr_conv2" x1="864" y1="317" x2="864" y2="341" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Cardinal k: Split 1 conv2 -> Split Attention -->
    <path id="edge_ck_s1_to_attn" data-id="edge_ck_s1_to_attn" data-class="edge" data-source="node_ck_s1_conv2" data-target="node_ck_split_attn" d="M 635 430 L 695 455" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Cardinal k: Split r conv2 -> Split Attention -->
    <path id="edge_ck_sr_to_attn" data-id="edge_ck_sr_to_attn" data-class="edge" data-source="node_ck_sr_conv2" data-target="node_ck_split_attn" d="M 865 430 L 805 455" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Cardinal 1 -> Concatenate -->
    <path id="edge_c1_to_concat" data-id="edge_c1_to_concat" data-class="edge" data-source="block_cardinal_1" data-target="node_concatenate" d="M 430 520 L 468 552" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Cardinal k -> Concatenate -->
    <path id="edge_ck_to_concat" data-id="edge_ck_to_concat" data-class="edge" data-source="block_cardinal_k" data-target="node_concatenate" d="M 565 520 L 526 552" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Concatenate -> Conv 1x1, c -->
    <line id="edge_concat_to_conv" data-id="edge_concat_to_conv" data-class="edge" data-source="node_concatenate" data-target="node_conv_1x1_c" x1="497" y1="603" x2="497" y2="628" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Conv 1x1, c -> Add -->
    <line id="edge_conv_to_add" data-id="edge_conv_to_add" data-class="edge" data-source="node_conv_1x1_c" data-target="node_add" x1="497" y1="679" x2="497" y2="709" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>

    <!-- Residual Connection: Input -> Add -->
    <path id="edge_residual" data-id="edge_residual" data-class="edge" data-source="node_input" data-target="node_add" d="M 582 133 L 996 133 L 996 728 L 516 728" fill="none" stroke="#000000" stroke-width="2.2" marker-end="url(#arrow)"/>
  </g>

  <!-- Dynamic Narration Banner -->
  <g id="narration_banner">
    <rect x="62" y="785" width="900" height="65" rx="8" fill="#f5f7fa" stroke="#cbd5e1" stroke-width="1.5"/>
    <text id="narr_ts1" class="narr-text" x="512" y="822">
      <tspan x="512">The ResNeSt block receives an input feature map with specified height, width, and channels.</tspan>
    </text>
    <text id="narr_ts2" class="narr-text" x="512" y="822">
      <tspan x="512">The input is distributed across multiple cardinal groups, starting with the first cardinal group.</tspan>
    </text>
    <text id="narr_ts3" class="narr-text" x="512" y="814">
      <tspan x="512">Within this group, the first split processes the features using a one-by-one convolution</tspan>
      <tspan x="512" dy="1.25em">followed by a three-by-three convolution.</tspan>
    </text>
    <text id="narr_ts4" class="narr-text" x="512" y="822">
      <tspan x="512">This transformation is replicated across all split branches within the cardinal group.</tspan>
    </text>
    <text id="narr_ts5" class="narr-text" x="512" y="814">
      <tspan x="512">A Split Attention module then fuses the representations from each split</tspan>
      <tspan x="512" dy="1.25em">to generate the cardinal group's output.</tspan>
    </text>
    <text id="narr_ts6" class="narr-text" x="512" y="822">
      <tspan x="512">The same structure operates in parallel across the remaining cardinal groups.</tspan>
    </text>
    <text id="narr_ts7" class="narr-text" x="512" y="822">
      <tspan x="512">In the final cardinal group, the first split applies its convolutional layers.</tspan>
    </text>
    <text id="narr_ts8" class="narr-text" x="512" y="822">
      <tspan x="512">The subsequent splits perform identical feature transformations.</tspan>
    </text>
    <text id="narr_ts9" class="narr-text" x="512" y="822">
      <tspan x="512">Split Attention then integrates the split feature representations.</tspan>
    </text>
    <text id="narr_ts10" class="narr-text" x="512" y="822">
      <tspan x="512">The outputs from all cardinal groups are concatenated along the channel dimension.</tspan>
    </text>
    <text id="narr_ts11" class="narr-text" x="512" y="814">
      <tspan x="512">A final one-by-one convolution projects the concatenated features</tspan>
      <tspan x="512" dy="1.25em">to the target channel dimension.</tspan>
    </text>
    <text id="narr_ts12" class="narr-text" x="512" y="814">
      <tspan x="512">Finally, the result is combined with the original input through a shortcut connection</tspan>
      <tspan x="512" dy="1.25em">to form the block output.</tspan>
    </text>
  </g>
</svg>