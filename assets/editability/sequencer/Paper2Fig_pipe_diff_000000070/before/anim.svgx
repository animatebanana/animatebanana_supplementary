<svg xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1850 1120" width="1850" height="1120">
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
      <path d="M 0 0 L 10 5 L 0 10 Z" fill="#b0b0b0" />
    </marker>
    
    <style type="text/css">
      /* Base Opacity for Animated Elements */
      #block_input_video, #text_input_video, #raster_input_video,
      #block_super_pixels, #text_super_pixels, #edge_input_to_super, #raster_super_pixels,
      #node_joint_segmentation, #text_joint_segmentation_1, #text_joint_segmentation_2, #edge_super_to_joint,
      #block_image_segmentations, #text_image_segmentations, #edge_joint_to_image, #raster_image_segmentations {
        opacity: 0.15;
        transition: opacity 0.1s ease-in-out;
      }

      /* Base Opacity for Static/Masked Elements */
      #node_lsd_slam, #text_lsd_slam, #edge_input_to_lsd,
      #node_key_frames, #text_key_frames, #text_camera_poses, #text_point_cloud, #edge_lsd_to_key,
      #block_depth_maps, #text_depth_maps, #edge_input_to_depth, #raster_depth_maps,
      #block_fused_sdf, #text_fused_sdf, #edge_depth_to_fused, #raster_fused_sdf,
      #block_deformed_sdf, #text_deformed_sdf, #edge_fused_to_deformed, #raster_deformed_sdf,
      #edge_deformed_to_joint,
      #block_reconstructed_mesh, #text_reconstructed_mesh, #edge_joint_to_recon, #raster_reconstructed_mesh {
        opacity: 0.15;
      }

      /* Base Opacity for Narrations */
      .narr-text {
        opacity: 0;
      }

      /* Bindings to Keyframe Animations */
      #block_input_video, #text_input_video { animation: anim_input_video_block 28s infinite; }
      #raster_input_video { animation: anim_input_video_raster 28s infinite; }
      #edge_input_to_super { animation: anim_edge_input_to_super 28s infinite; }
      #block_super_pixels, #text_super_pixels { animation: anim_super_pixels_block 28s infinite; }
      #raster_super_pixels { animation: anim_super_pixels_raster 28s infinite; }
      #edge_super_to_joint { animation: anim_edge_super_to_joint 28s infinite; }
      #node_joint_segmentation, #text_joint_segmentation_1, #text_joint_segmentation_2 { animation: anim_joint_segmentation 28s infinite; }
      #edge_joint_to_image { animation: anim_edge_joint_to_image 28s infinite; }
      #block_image_segmentations, #text_image_segmentations { animation: anim_image_segmentations_block 28s infinite; }
      #raster_image_segmentations { animation: anim_image_segmentations_raster 28s infinite; }

      #narr_ts1 { animation: anim_narr_ts1 28s infinite; }
      #narr_ts2 { animation: anim_narr_ts2 28s infinite; }
      #narr_ts3 { animation: anim_narr_ts3 28s infinite; }
      #narr_ts4 { animation: anim_narr_ts4 28s infinite; }
      #narr_ts5 { animation: anim_narr_ts5 28s infinite; }
      #narr_ts6 { animation: anim_narr_ts6 28s infinite; }
      #narr_ts7 { animation: anim_narr_ts7 28s infinite; }

      /* Diagram Elements Keyframes */
      @keyframes anim_input_video_block {
        0% { opacity: 1.0; }
        27.07% { opacity: 1.0; }
        28.57% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_input_video_raster {
        0% { opacity: 0.15; }
        12.78% { opacity: 0.15; }
        14.28% { opacity: 1.0; }
        27.07% { opacity: 1.0; }
        28.57% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_edge_input_to_super {
        0% { opacity: 0.15; }
        27.07% { opacity: 0.15; }
        28.57% { opacity: 1.0; }
        41.35% { opacity: 1.0; }
        42.85% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_super_pixels_block {
        0% { opacity: 0.15; }
        27.07% { opacity: 0.15; }
        28.57% { opacity: 1.0; }
        55.64% { opacity: 1.0; }
        57.14% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_super_pixels_raster {
        0% { opacity: 0.15; }
        41.35% { opacity: 0.15; }
        42.85% { opacity: 1.0; }
        55.64% { opacity: 1.0; }
        57.14% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_edge_super_to_joint {
        0% { opacity: 0.15; }
        55.64% { opacity: 0.15; }
        57.14% { opacity: 1.0; }
        69.92% { opacity: 1.0; }
        71.42% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_joint_segmentation {
        0% { opacity: 0.15; }
        55.64% { opacity: 0.15; }
        57.14% { opacity: 1.0; }
        69.92% { opacity: 1.0; }
        71.42% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_edge_joint_to_image {
        0% { opacity: 0.15; }
        69.92% { opacity: 0.15; }
        71.42% { opacity: 1.0; }
        84.21% { opacity: 1.0; }
        85.71% { opacity: 0.15; }
        100% { opacity: 0.15; }
      }
      @keyframes anim_image_segmentations_block {
        0% { opacity: 0.15; }
        69.92% { opacity: 0.15; }
        71.42% { opacity: 1.0; }
        98.50% { opacity: 1.0; }
        100% { opacity: 1.0; }
      }
      @keyframes anim_image_segmentations_raster {
        0% { opacity: 0.15; }
        84.21% { opacity: 0.15; }
        85.71% { opacity: 1.0; }
        98.50% { opacity: 1.0; }
        100% { opacity: 1.0; }
      }

      /* Narration Keyframes */
      @keyframes anim_narr_ts1 {
        0% { opacity: 1.0; }
        13.28% { opacity: 1.0; }
        14.28% { opacity: 0; }
        100% { opacity: 0; }
      }
      @keyframes anim_narr_ts2 {
        0% { opacity: 0; }
        13.28% { opacity: 0; }
        14.28% { opacity: 1.0; }
        27.57% { opacity: 1.0; }
        28.57% { opacity: 0; }
        100% { opacity: 0; }
      }
      @keyframes anim_narr_ts3 {
        0% { opacity: 0; }
        27.57% { opacity: 0; }
        28.57% { opacity: 1.0; }
        41.85% { opacity: 1.0; }
        42.85% { opacity: 0; }
        100% { opacity: 0; }
      }
      @keyframes anim_narr_ts4 {
        0% { opacity: 0; }
        41.85% { opacity: 0; }
        42.85% { opacity: 1.0; }
        56.14% { opacity: 1.0; }
        57.14% { opacity: 0; }
        100% { opacity: 0; }
      }
      @keyframes anim_narr_ts5 {
        0% { opacity: 0; }
        56.14% { opacity: 0; }
        57.14% { opacity: 1.0; }
        70.42% { opacity: 1.0; }
        71.42% { opacity: 0; }
        100% { opacity: 0; }
      }
      @keyframes anim_narr_ts6 {
        0% { opacity: 0; }
        70.42% { opacity: 0; }
        71.42% { opacity: 1.0; }
        84.71% { opacity: 1.0; }
        85.71% { opacity: 0; }
        100% { opacity: 0; }
      }
      @keyframes anim_narr_ts7 {
        0% { opacity: 0; }
        84.71% { opacity: 0; }
        85.71% { opacity: 1.0; }
        99.00% { opacity: 1.0; }
        100% { opacity: 1.0; }
      }
    </style>
  </defs>

  <!-- Edges (Arrows) -->
  <g id="edges">
    <!-- Input Video -> LSD-SLAM -->
    <line id="edge_input_to_lsd" x1="225" y1="340" x2="225" y2="245" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_input_to_lsd" data-class="edge" data-source="block_input_video" data-target="node_lsd_slam" />
    
    <!-- Input Video -> Depth Maps -->
    <line id="edge_input_to_depth" x1="225" y1="620" x2="225" y2="665" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_input_to_depth" data-class="edge" data-source="block_input_video" data-target="block_depth_maps" />
    
    <!-- Input Video -> Super-pixels -->
    <line id="edge_input_to_super" x1="420" y1="480" x2="485" y2="480" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_input_to_super" data-class="edge" data-source="block_input_video" data-target="block_super_pixels" />
    
    <!-- LSD-SLAM -> Key-Frames -->
    <line id="edge_lsd_to_key" x1="310" y1="140" x2="540" y2="140" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_lsd_to_key" data-class="edge" data-source="node_lsd_slam" data-target="node_key_frames" />
    
    <!-- Depth Maps -> Fused SDF -->
    <line id="edge_depth_to_fused" x1="420" y1="820" x2="485" y2="820" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_depth_to_fused" data-class="edge" data-source="block_depth_maps" data-target="block_fused_sdf" />
    
    <!-- Fused SDF -> Deformed SDF -->
    <line id="edge_fused_to_deformed" x1="890" y1="820" x2="955" y2="820" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_fused_to_deformed" data-class="edge" data-source="block_fused_sdf" data-target="block_deformed_sdf" />
    
    <!-- Deformed SDF -> 2D-3D Joint Segmentation -->
    <line id="edge_deformed_to_joint" x1="1175" y1="680" x2="1175" y2="610" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_deformed_to_joint" data-class="edge" data-source="block_deformed_sdf" data-target="node_joint_segmentation" />
    
    <!-- Super-pixels -> 2D-3D Joint Segmentation -->
    <line id="edge_super_to_joint" x1="890" y1="480" x2="1045" y2="480" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_super_to_joint" data-class="edge" data-source="block_super_pixels" data-target="node_joint_segmentation" />
    
    <!-- 2D-3D Joint Segmentation -> Image Segmentations -->
    <line id="edge_joint_to_image" x1="1175" y1="365" x2="1175" y2="315" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_joint_to_image" data-class="edge" data-source="node_joint_segmentation" data-target="block_image_segmentations" />
    
    <!-- 2D-3D Joint Segmentation -> Reconstructed 3D Mesh -->
    <line id="edge_joint_to_recon" x1="1290" y1="480" x2="1435" y2="480" fill="none" stroke="#b0b0b0" stroke-width="8" marker-end="url(#arrow)" data-id="edge_joint_to_recon" data-class="edge" data-source="node_joint_segmentation" data-target="block_reconstructed_mesh" />
  </g>

  <!-- Nodes and Blocks -->
  
  <!-- LSD-SLAM Node -->
  <g id="node_lsd_slam" data-id="node_lsd_slam" data-class="standalone_node" data-parent="root">
    <circle cx="225" cy="140" r="85" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_lsd_slam" x="225" y="150" font-family="sans-serif" font-size="28px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_lsd_slam" data-class="text_node" data-parent="node_lsd_slam">LSD-SLAM</text>
  </g>

  <!-- Key-Frames Camera Poses Point Cloud Node -->
  <g id="node_key_frames" data-id="node_key_frames" data-class="standalone_node" data-parent="root">
    <rect x="565" y="40" width="260" height="200" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_key_frames" x="695" y="95" font-family="sans-serif" font-size="28px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_key_frames" data-class="text_node" data-parent="node_key_frames">Key-Frames</text>
    <text id="text_camera_poses" x="695" y="135" font-family="sans-serif" font-size="28px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_camera_poses" data-class="text_node" data-parent="node_key_frames">Camera Poses</text>
    <text id="text_point_cloud" x="695" y="175" font-family="sans-serif" font-size="28px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_point_cloud" data-class="text_node" data-parent="node_key_frames">Point Cloud</text>
  </g>

  <!-- Input Video Block -->
  <g id="block_input_video" data-id="block_input_video" data-class="block" data-parent="root">
    <rect x="30" y="340" width="390" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_input_video" x="225" y="385" font-family="sans-serif" font-size="32px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_input_video" data-class="text_node" data-parent="block_input_video">Input Video</text>
    <g id="raster_input_video" data-id="raster_input_video" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_input_video.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_input_video.png" x="55" y="405" width="340" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- Depth Maps Block -->
  <g id="block_depth_maps" data-id="block_depth_maps" data-class="block" data-parent="root">
    <rect x="30" y="680" width="390" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_depth_maps" x="225" y="725" font-family="sans-serif" font-size="32px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_depth_maps" data-class="text_node" data-parent="block_depth_maps">Depth Maps</text>
    <g id="raster_depth_maps" data-id="raster_depth_maps" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_depth_maps.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_depth_maps.png" x="55" y="745" width="340" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- Super-pixels Block -->
  <g id="block_super_pixels" data-id="block_super_pixels" data-class="block" data-parent="root">
    <rect x="500" y="340" width="390" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_super_pixels" x="695" y="385" font-family="sans-serif" font-size="32px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_super_pixels" data-class="text_node" data-parent="block_super_pixels">Super-pixels</text>
    <g id="raster_super_pixels" data-id="raster_super_pixels" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_super_pixels.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_super_pixels.png" x="525" y="405" width="340" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- Fused SDF Block -->
  <g id="block_fused_sdf" data-id="block_fused_sdf" data-class="block" data-parent="root">
    <rect x="500" y="680" width="390" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_fused_sdf" x="695" y="725" font-family="sans-serif" font-size="32px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_fused_sdf" data-class="text_node" data-parent="block_fused_sdf">Fused SDF</text>
    <g id="raster_fused_sdf" data-id="raster_fused_sdf" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_fused_sdf.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_fused_sdf.png" x="560" y="745" width="270" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- Image Segmentations Block -->
  <g id="block_image_segmentations" data-id="block_image_segmentations" data-class="block" data-parent="root">
    <rect x="970" y="20" width="410" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_image_segmentations" x="1175" y="65" font-family="sans-serif" font-size="32px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_image_segmentations" data-class="text_node" data-parent="block_image_segmentations">Image Segmentations</text>
    <g id="raster_image_segmentations" data-id="raster_image_segmentations" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_image_segmentations.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_image_segmentations.png" x="990" y="85" width="370" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- 2D-3D Joint Segmentation Node -->
  <g id="node_joint_segmentation" data-id="node_joint_segmentation" data-class="standalone_node" data-parent="root">
    <circle cx="1175" cy="480" r="115" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_joint_segmentation_1" x="1175" y="465" font-family="sans-serif" font-size="28px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_joint_segmentation_1" data-class="text_node" data-parent="node_joint_segmentation">2D-3D Joint</text>
    <text id="text_joint_segmentation_2" x="1175" y="505" font-family="sans-serif" font-size="28px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_joint_segmentation_2" data-class="text_node" data-parent="node_joint_segmentation">Segmentation</text>
  </g>

  <!-- Deformed SDF Block -->
  <g id="block_deformed_sdf" data-id="block_deformed_sdf" data-class="block" data-parent="root">
    <rect x="970" y="680" width="410" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_deformed_sdf" x="1175" y="725" font-family="sans-serif" font-size="32px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_deformed_sdf" data-class="text_node" data-parent="block_deformed_sdf">Deformed SDF</text>
    <g id="raster_deformed_sdf" data-id="raster_deformed_sdf" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_deformed_sdf.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_deformed_sdf.png" x="1030" y="745" width="290" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- Reconstructed 3D Mesh Block -->
  <g id="block_reconstructed_mesh" data-id="block_reconstructed_mesh" data-class="block" data-parent="root">
    <rect x="1450" y="340" width="380" height="280" rx="30" fill="#ffffff" stroke="#000000" stroke-width="4" />
    <text id="text_reconstructed_mesh" x="1640" y="385" font-family="sans-serif" font-size="30px" font-weight="bold" text-anchor="middle" fill="#000000" data-id="text_reconstructed_mesh" data-class="text_node" data-parent="block_reconstructed_mesh">Reconstructed 3D Mesh</text>
    <g id="raster_reconstructed_mesh" data-id="raster_reconstructed_mesh" data-class="raster_node"><image href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_reconstructed_mesh.png" xlink:href="assets/editability/sequencer/Paper2Fig_pipe_diff_000000070/before/rasters/crop_raster_reconstructed_mesh.png" x="1475" y="405" width="330" height="190" preserveAspectRatio="xMidYMid meet" /></g>
  </g>

  <!-- Dynamic Narration Banner -->
  <g id="narration_banner">
    <!-- Background card for narration -->
    <rect x="50" y="990" width="1750" height="110" rx="15" fill="#f8f9fa" stroke="#e9ecef" stroke-width="2" />
    
    <!-- TS 1 -->
    <text id="narr_ts1" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">The pipeline begins with the input video stream,</tspan>
      <tspan x="925" dy="32">capturing the target object from multiple viewpoints.</tspan>
    </text>
    
    <!-- TS 2 -->
    <text id="narr_ts2" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">These video frames serve as the primary visual source</tspan>
      <tspan x="925" dy="32">for downstream 2D processing and segmentation.</tspan>
    </text>
    
    <!-- TS 3 -->
    <text id="narr_ts3" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">The input video frames are then routed to the super-pixels module</tspan>
      <tspan x="925" dy="32">to group homogeneous image regions.</tspan>
    </text>
    
    <!-- TS 4 -->
    <text id="narr_ts4" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">Decomposing the frames into super-pixels simplifies the visual representation</tspan>
      <tspan x="925" dy="32">and reduces downstream computational complexity.</tspan>
    </text>
    
    <!-- TS 5 -->
    <text id="narr_ts5" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">These super-pixels are passed to the 2D-3D joint segmentation module</tspan>
      <tspan x="925" dy="32">to establish spatial and appearance consistency.</tspan>
    </text>
    
    <!-- TS 6 -->
    <text id="narr_ts6" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">The joint segmentation module optimizes the boundaries</tspan>
      <tspan x="925" dy="32">to produce highly accurate 2D image segmentations.</tspan>
    </text>
    
    <!-- TS 7 -->
    <text id="narr_ts7" class="narr-text" x="925" y="1025" font-family="sans-serif" font-size="24px" fill="#212529" text-anchor="middle">
      <tspan x="925" dy="0">These final image segmentations cleanly isolate the target object</tspan>
      <tspan x="925" dy="32">from the background across all video frames.</tspan>
    </text>
  </g>

</svg>