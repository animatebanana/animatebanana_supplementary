      </g>
    </g>
  </g>

  <!-- ================= BLOCK 4: PERSON IDENTIFICATION ================= -->
  <g id="block_person_ident" data-id="block_person_ident" data-class="block" data-parent="root">
    <!-- Background -->
    <rect id="rect_person_ident_bg" data-id="rect_person_ident_bg" data-class="child_node" data-parent="block_person_ident" x="480" y="400" width="494" height="265" rx="4" fill="#f0fdf4" stroke="#374151" stroke-width="2.5"/>
    <!-- Title -->
    <text id="text_person_ident_title" data-id="text_person_ident_title" data-class="text_node" data-parent="block_person_ident" x="727" y="440" fill="#111827" font-size="24" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Person Identification</text>

    <!-- Face Detection -->
    <g id="box_face_detection" data-id="box_face_detection" data-class="child_node" data-parent="block_person_ident">
      <rect id="rect_face_detection" data-id="rect_face_detection" data-class="child_node" data-parent="box_face_detection" x="502" y="470" width="204" height="64" rx="4" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
      <text id="text_face_detection" data-id="text_face_detection" data-class="text_node" data-parent="box_face_detection" x="604" y="508" fill="#1e293b" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Face Detection</text>
    </g>

    <!-- Arrow: Detection -> Extraction -->
    <path id="edge_detect_to_extract" data-id="edge_detect_to_extract" data-class="edge" data-source="box_face_detection" data-target="box_ident_feat_extract" d="M 604 534 L 604 574" stroke="#059669" stroke-width="3" fill="none" marker-end="url(#arrow-green)"/>

    <!-- Feature Extraction -->
    <g id="box_ident_feat_extract" data-id="box_ident_feat_extract" data-class="child_node" data-parent="block_person_ident">
      <rect id="rect_ident_feat_extract" data-id="rect_ident_feat_extract" data-class="child_node" data-parent="box_ident_feat_extract" x="502" y="574" width="204" height="64" rx="4" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
      <text id="text_ident_feat_1" data-id="text_ident_feat_1" data-class="text_node" data-parent="box_ident_feat_extract" x="604" y="602" fill="#1e293b" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Feature</text>
      <text id="text_ident_feat_2" data-id="text_ident_feat_2" data-class="text_node" data-parent="box_ident_feat_extract" x="604" y="624" fill="#1e293b" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Extraction</text>
    </g>

    <!-- Arrow: Extraction -> Verification -->
    <path id="edge_extract_to_verify" data-id="edge_extract_to_verify" data-class="edge" data-source="box_ident_feat_extract" data-target="box_face_verification" d="M 706 606 L 726 606 L 726 502 L 748 502" stroke="#059669" stroke-width="3" fill="none" marker-end="url(#arrow-green)"/>

    <!-- Face Verification -->
    <g id="box_face_verification" data-id="box_face_verification" data-class="child_node" data-parent="block_person_ident">
      <rect id="rect_face_verification" data-id="rect_face_verification" data-class="child_node" data-parent="box_face_verification" x="748" y="470" width="204" height="64" rx="4" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
      <text id="text_face_verify_1" data-id="text_face_verify_1" data-class="text_node" data-parent="box_face_verification" x="850" y="498" fill="#1e293b" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Face</text>
      <text id="text_face_verify_2" data-id="text_face_verify_2" data-class="text_node" data-parent="box_face_verification" x="850" y="520" fill="#1e293b" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Verification</text>
    </g>

    <!-- Arrow: Verification -> Visualization -->
    <path id="edge_verify_to_visual" data-id="edge_verify_to_visual" data-class="edge" data-source="box_face_verification" data-target="box_visualization" d="M 850 534 L 850 574" stroke="#059669" stroke-width="3" fill="none" marker-end="url(#arrow-green)"/>

    <!-- Visualization -->
    <g id="box_visualization" data-id="box_visualization" data-class="child_node" data-parent="block_person_ident">
      <rect id="rect_visualization" data-id="rect_visualization" data-class="child_node" data-parent="box_visualization" x="748" y="574" width="204" height="64" rx="4" fill="#dcfce7" stroke="#22c55e" stroke-width="2"/>
      <text id="text_visualization" data-id="text_visualization" data-class="text_node" data-parent="box_visualization" x="850" y="612" fill="#1e293b" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Visualization</text>
    </g>
  </g>

  <!-- ================= INTER-BLOCK CONNECTING ARROWS ================= -->
  <g id="group_inter_block_edges">
    <path id="edge_red_to_dict" data-id="edge_red_to_dict" data-class="edge" data-source="block_cnn_training" data-target="box_dict_feat_extract" d="M 358 176 L 430 176 L 430 214 L 592 214" stroke="#b91c1c" stroke-width="3" fill="none" marker-end="url(#arrow-red)"/>
    <path id="edge_red_to_ident" data-id="edge_red_to_ident" data-class="edge" data-source="block_cnn_training" data-target="box_ident_feat_extract" d="M 430 214 L 430 606 L 502 606" stroke="#b91c1c" stroke-width="3" fill="none" marker-end="url(#arrow-red)"/>
    <path id="edge_archive_to_detect" data-id="edge_archive_to_detect" data-class="edge" data-source="block_web_content" data-target="box_face_detection" d="M 384 574 L 446 574 L 446 502 L 502 502" stroke="#d97706" stroke-width="3" fill="none" marker-end="url(#arrow-yellow)"/>
    <path id="edge_dict_to_verify" data-id="edge_dict_to_verify" data-class="edge" data-source="box_dict_filtering" data-target="box_face_verification" d="M 772 342 L 772 380 L 990 380 L 990 502 L 952 502" stroke="#002b9e" stroke-width="3" fill="none" marker-end="url(#arrow-blue)"/>
  </g>

  <!-- ================= DYNAMIC NARRATION BANNER ================= -->
  <g id="narration_banner">
    <rect x="10" y="685" width="974" height="120" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="2" />
    
    <text id="narr_ts1" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">The workflow of the person identification framework begins with</tspan>
      <tspan x="50%" dy="1.3em">training a facial feature extractor and building a person dictionary.</tspan>
    </text>

    <text id="narr_ts2" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">The Facial Feature Extractor block is responsible for</tspan>
      <tspan x="50%" dy="1.3em">learning a robust representation of facial characteristics.</tspan>
    </text>

    <text id="narr_ts3" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">It utilizes a training dataset containing facial images.</tspan>
    </text>

    <text id="narr_ts4" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">This dataset is used to train a convolutional neural network, or CNN.</tspan>
      <tspan x="50%" dy="1.3em">The CNN learns to extract robust feature representations to describe facial characteristics.</tspan>
    </text>

    <text id="narr_ts5" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">Next, the Person Dictionary block defines a lexicon of target entities for a given domain.</tspan>
    </text>

    <text id="narr_ts6" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">First, entities are selected, and exemplary images are</tspan>
      <tspan x="50%" dy="1.3em">gathered from the web using an image search engine.</tspan>
    </text>

    <text id="narr_ts7" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">The trained CNN is then applied to extract facial features from these gathered images.</tspan>
    </text>

    <text id="narr_ts8" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">A filtering step is performed to reduce noise and improve the quality of the sample dataset.</tspan>
    </text>

    <text id="narr_ts9" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">To identify these entities in real-world data, the system</tspan>
      <tspan x="50%" dy="1.3em">retrieves content from the Internet Archive.</tspan>
    </text>

    <text id="narr_ts10" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">The Internet Archive serves as the primary source of historical web data.</tspan>
    </text>

    <text id="narr_ts11" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">Web content, such as images from archived web pages, is</tspan>
      <tspan x="50%" dy="1.3em">extracted according to a predefined search space.</tspan>
    </text>

    <text id="narr_ts12" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">These web pages contain the target images in which persons of interest will be identified.</tspan>
    </text>

    <text id="narr_ts13" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">Finally, the Person Identification block processes the retrieved</tspan>
      <tspan x="50%" dy="1.3em">web images to locate and verify the target entities.</tspan>
    </text>

    <text id="narr_ts14" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">First, face detection is performed on the web images to locate any faces.</tspan>
    </text>

    <text id="narr_ts15" class="narr_text" x="50%" y="745" text-anchor="middle">
      <tspan x="50%" dy="0">For each detected face, features are extracted using the trained CNN model.</tspan>
    </text>

    <text id="narr_ts16" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">Face verification is then conducted by comparing the extracted</tspan>
      <tspan x="50%" dy="1.3em">features against the filtered Person Dictionary.</tspan>
    </text>

    <text id="narr_ts17" class="narr_text" x="50%" y="735" text-anchor="middle">
      <tspan x="50%" dy="0">Finally, the identified occurrences and relations of the</tspan>
      <tspan x="50%" dy="1.3em">persons of interest are visualized for analysis.</tspan>
    </text>
  </g>

  <!-- ================= THE FOCUS BOX ================= -->
  <rect id="focus_box" fill="none" stroke="#FF0000" stroke-width="4" stroke-dasharray="8,4" rx="6" />
</svg>