      <rect id="building_base2" data-id="building_base2" data-class="composite_part" data-parent="icon_archive_building" x="60" y="607" width="96" height="5" fill="#111827"/>
    </g>

    <!-- Arrow: Archive -> Web Content -->
    <path id="edge_archive_to_web" data-id="edge_archive_to_web" data-class="edge" data-source="icon_archive_building" data-target="block_web_content" d="M 164 552 L 224 552" stroke="#4b5563" stroke-width="6" fill="none" marker-end="url(#arrow-gray)"/>

    <!-- Web Content Sub-Block -->
    <g id="block_web_content" data-id="block_web_content" data-class="block" data-parent="block_internet_archive">
      <text id="text_web_content_title" data-id="text_web_content_title" data-class="text_node" data-parent="block_web_content" x="306" y="490" fill="#1f2937" font-size="18" font-weight="bold" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle">Web Content</text>

      <!-- Browser Windows -->
      <g id="web_windows" data-id="web_windows" data-class="composite_whole" data-parent="block_web_content">
        <rect id="win1_bg" data-id="win1_bg" data-class="composite_part" data-parent="web_windows" x="238" y="502" width="102" height="72" rx="3" fill="#ffffff" stroke="#374151" stroke-width="2"/>
