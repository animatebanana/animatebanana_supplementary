        <rect id="win3_bar" data-id="win3_bar" data-class="composite_part" data-parent="web_windows" x="256" y="534" width="98" height="14" fill="#e2e8f0" stroke="#374151" stroke-width="2"/>
        <circle id="win3_dot1" data-id="win3_dot1" data-class="composite_part" data-parent="web_windows" cx="262" cy="541" r="2" fill="#ef4444"/>
        <circle id="win3_dot2" data-id="win3_dot2" data-class="composite_part" data-parent="web_windows" cx="268" cy="541" r="2" fill="#f59e0b"/>
        <circle id="win3_dot3" data-id="win3_dot3" data-class="composite_part" data-parent="web_windows" cx="274" cy="541" r="2" fill="#10b981"/>
        
        <rect id="win3_img" data-id="win3_img" data-class="composite_part" data-parent="web_windows" x="264" y="556" width="34" height="34" rx="2" fill="#f1f5f9" stroke="#4b5563" stroke-width="1.5"/>
        <polygon id="win3_mountain" data-id="win3_mountain" data-class="composite_part" data-parent="web_windows" points="266,586 276,572 284,582 292,574 296,586" fill="#cbd5e1"/>
        <circle id="win3_sun" data-id="win3_sun" data-class="composite_part" data-parent="web_windows" cx="272" cy="564" r="2.5" fill="#cbd5e1"/>
        <line id="win3_line1" data-id="win3_line1" data-class="composite_part" data-parent="web_windows" x1="306" y1="560" x2="346" y2="560" stroke="#94a3b8" stroke-width="2"/>
        <line id="win3_line2" data-id="win3_line2" data-class="composite_part" data-parent="web_windows" x1="306" y1="568" x2="346" y2="568" stroke="#94a3b8" stroke-width="2"/>
