        <rect id="win2_bg" data-id="win2_bg" data-class="composite_part" data-parent="web_windows" x="256" y="518" width="122" height="76" rx="3" fill="#ffffff" stroke="#374151" stroke-width="2"/>
        <rect id="win2_bar" data-id="win2_bar" data-class="composite_part" data-parent="web_windows" x="256" y="518" width="122" height="14" fill="#e2e8f0" stroke="#374151" stroke-width="2"/>

